---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DemoModal from "../components/DemoModal.astro";
import { SITE } from "../data/site.js";
import { siteGraph } from "../lib/schema.js";

const {
  title,
  description = SITE.description,
  // Path with leading + trailing slash, e.g. "/pricing/".
  path = "/",
  ogImage = SITE.ogImage,
  ogImageAlt = "RegRely — GDPR compliance automation",
  schema = [],
  noindex = false,
  bodyClass = "",
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

const webPage = {
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { "@id": `${SITE.url}/#website` },
  inLanguage: "en-US",
};

const graph = { "@context": "https://schema.org", "@graph": [...siteGraph(), webPage, ...schema] };

const ASSET_VERSION = "20260718-5";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fbff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#061632" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
    <link rel="shortcut icon" href="/assets/img/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href={`/assets/css/styles.css?v=${ASSET_VERSION}`} />
    <link rel="stylesheet" href={`/assets/css/enhance.css?v=${ASSET_VERSION}`} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />

    <!-- Set theme before paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("regrely-theme");
          if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
    <script is:inline define:vars={{ gaId: SITE.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", gaId);
    </script>
  </head>
  <body class={bodyClass}>
    <a class="visually-hidden-focusable" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" class="page-wrap">
      <slot />
    </main>
    <Footer />
    <DemoModal />

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
      is:inline></script>
    <script is:inline src={`/assets/js/main.js?v=${ASSET_VERSION}`}></script>
    <script is:inline src={`/assets/js/enhance.js?v=${ASSET_VERSION}`}></script>
  </body>
</html>
