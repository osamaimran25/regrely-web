---
import BaseLayout from "../layouts/BaseLayout.astro";
import html from "../partials/index.html?raw";
import headHtml from "../partials/index.head.html?raw";
const title = "GDPR Compliance Software for Growing Businesses | RegRely";
const description = "Affordable GDPR compliance software for SMEs. Automate DSARs, ROPA, consent, risk and audit evidence without enterprise complexity. Start a 14-day trial.";
---

<BaseLayout title={title} description={description} path="/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
