---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/blog__index.html?raw";
import headHtml from "../../partials/blog__index.head.html?raw";
const title = "Privacy & GDPR Compliance Guides | RegRely Blog";
const description = "Practical guidance on GDPR, DSARs, ROPAs, consent, DPIAs, and privacy operations — written for teams that have to actually run the process.";
---

<BaseLayout title={title} description={description} path="/blog/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
