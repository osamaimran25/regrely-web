---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/blog__what-is-a-ropa.html?raw";
import headHtml from "../../partials/blog__what-is-a-ropa.head.html?raw";
const title = "What Is a ROPA? GDPR Article 30 Explained | RegRely";
