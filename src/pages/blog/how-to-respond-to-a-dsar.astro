---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/blog__how-to-respond-to-a-dsar.html?raw";
import headHtml from "../../partials/blog__how-to-respond-to-a-dsar.head.html?raw";
const title = "How to Respond to a DSAR — Step-by-Step Guide | RegRely";
const description = "Follow a step-by-step GDPR DSAR process covering deadlines, identity checks, data search, redaction, approval, delivery and evidence retention.";
