---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/regulations__gdpr.html?raw";
import headHtml from "../../partials/regulations__gdpr.head.html?raw";
const title = "GDPR Compliance Software — DSAR, ROPA &amp; Consent | RegRely";
const description = "What GDPR requires, who it applies to, and how RegRely automates the operational work — DSAR fulfilment, records of processing, consent, risk, and audit-ready evidence.";
---

<BaseLayout title={title} description={description} path="/regulations/gdpr/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
