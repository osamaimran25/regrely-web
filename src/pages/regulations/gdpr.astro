---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/regulations__gdpr.html?raw";
import headHtml from "../../partials/regulations__gdpr.head.html?raw";
const title = "GDPR Compliance Software — DSAR, ROPA & Consent | RegRely";
const description = "Learn who GDPR applies to and how to manage DSAR fulfilment, records of processing, consent, privacy risk and audit-ready compliance evidence.";
---

<BaseLayout title={title} description={description} path="/regulations/gdpr/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
