---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/regulations__ccpa.html?raw";
import headHtml from "../../partials/regulations__ccpa.head.html?raw";
const title = "CCPA &amp; CPRA Compliance — Requirements Explained | RegRely";
const description = "What the CCPA and CPRA require, which businesses are in scope, what counts as selling or sharing data, and the consumer rights you must honour.";
---

<BaseLayout title={title} description={description} path="/regulations/ccpa/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
