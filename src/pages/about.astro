---
import BaseLayout from "../layouts/BaseLayout.astro";
import html from "../partials/about.html?raw";
const title = "About RegRely | Built for Mid-Market Compliance Teams";
const description = "RegRely was built to give mid-market companies enterprise-grade privacy compliance without enterprise pricing or long rollouts.";
