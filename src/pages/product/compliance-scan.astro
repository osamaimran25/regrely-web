---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/product__compliance-scan.html?raw";
import headHtml from "../../partials/product__compliance-scan.head.html?raw";
const title = "GDPR Compliance Assessment & Gap Analysis | RegRely";
const description = "Run a GDPR compliance assessment, identify control gaps, assign remediation owners and preserve evidence with RegRely compliance scanning software.";
---

<BaseLayout title={title} description={description} path="/product/compliance-scan/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
