---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/product__consent.html?raw";
import headHtml from "../../partials/product__consent.head.html?raw";
const title = "Consent Management & Tracking Software | RegRely";
const description = "Track consent status, purpose, policy version and withdrawal across products and regions. Keep a searchable, audit-ready record of every consent decision.";
---

<BaseLayout title={title} description={description} path="/product/consent/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
