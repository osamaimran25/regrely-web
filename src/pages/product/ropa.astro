---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/product__ropa.html?raw";
import headHtml from "../../partials/product__ropa.head.html?raw";
const title = "ROPA Software for GDPR Article 30 Records | RegRely";
const description = "Build and maintain an audit-ready record of processing activities. Map data, purposes, legal bases, retention, vendors, transfers and owners in one ROPA tool.";
---

<BaseLayout title={title} description={description} path="/product/ropa/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
