---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/product__risk-register.html?raw";
import headHtml from "../../partials/product__risk-register.head.html?raw";
const title = "Compliance Risk Register Software | RegRely";
const description = "Manage privacy and compliance risks with scoring, owners, mitigation plans, control evidence, review dates and documented residual-risk acceptance.";
---

<BaseLayout title={title} description={description} path="/product/risk-register/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
