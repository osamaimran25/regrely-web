---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/product__reports.html?raw";
import headHtml from "../../partials/product__reports.head.html?raw";
const title = "Compliance Reporting Software & Audit Evidence | RegRely";
const description = "Create compliance dashboards, management reports and audit-ready evidence exports across GDPR controls, privacy requests, risks and remediation.";
---

<BaseLayout title={title} description={description} path="/product/reports/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
