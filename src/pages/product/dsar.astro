---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/product__dsar.html?raw";
import headHtml from "../../partials/product__dsar.head.html?raw";
const title = "DSAR Software & Data Request Automation | RegRely";
const description = "DSAR software for GDPR and CCPA requests. Manage intake, identity checks, deadlines, data collection, approvals and audit-ready response evidence.";
---

<BaseLayout title={title} description={description} path="/product/dsar/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
