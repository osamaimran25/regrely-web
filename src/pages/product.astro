---
import BaseLayout from "../layouts/BaseLayout.astro";
import html from "../partials/product.html?raw";
import headHtml from "../partials/product.head.html?raw";
const title = "Data Privacy Management Software & GDPR Tools | RegRely";
const description = "Manage DSARs, ROPA, consent, privacy risks, compliance assessments and audit evidence in one affordable data privacy management platform.";
---

<BaseLayout title={title} description={description} path="/product/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
