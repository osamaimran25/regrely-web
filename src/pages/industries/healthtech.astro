---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/industries__healthtech.html?raw";
import headHtml from "../../partials/industries__healthtech.head.html?raw";
const title = "Healthcare Privacy & HIPAA Compliance Software | RegRely";
const description = "Manage healthcare privacy workflows, HIPAA-aware controls, risk assessments, data requests and audit evidence for growing healthtech companies.";
---

<BaseLayout title={title} description={description} path="/industries/healthtech/">
