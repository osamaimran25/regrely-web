---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/industries__edtech.html?raw";
import headHtml from "../../partials/industries__edtech.head.html?raw";
const title = "Edtech Privacy & Student Data Compliance Software | RegRely";
const description = "Manage student data privacy, guardian consent, retention, vendor risk, data requests and audit evidence with compliance software built for edtech teams.";
---

<BaseLayout title={title} description={description} path="/industries/edtech/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
