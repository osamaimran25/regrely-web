---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/industries__ecommerce.html?raw";
import headHtml from "../../partials/industries__ecommerce.head.html?raw";
const title = "Ecommerce GDPR & Privacy Compliance Software | RegRely";
const description = "Manage ecommerce consent records, customer data requests, processing activities, vendor risks and GDPR compliance evidence across every sales channel.";
---

<BaseLayout title={title} description={description} path="/industries/ecommerce/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
