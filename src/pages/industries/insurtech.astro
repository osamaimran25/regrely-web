import html from "../../partials/industries__insurtech.html?raw";
import headHtml from "../../partials/industries__insurtech.head.html?raw";
const title = "Insurtech Privacy & Risk Compliance Software | RegRely";
const description = "Govern policyholder and claims data with privacy workflows, risk ownership, vendor oversight, data requests and audit-ready compliance evidence.";
