---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/industries__saas.html?raw";
import headHtml from "../../partials/industries__saas.head.html?raw";
const title = "GDPR Compliance Software for SaaS Companies | RegRely";
const description = "GDPR compliance for SaaS teams: manage DPAs, subprocessors, ROPA, DSARs, privacy risks and audit evidence needed for enterprise security reviews.";
---

<BaseLayout title={title} description={description} path="/industries/saas/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
