---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/industries__logistics.html?raw";
import headHtml from "../../partials/industries__logistics.head.html?raw";
const title = "Logistics Data Privacy & Compliance Software | RegRely";
const description = "Map shipment, customer and workforce data across vendors and borders. Manage privacy requests, transfer risks and audit evidence for logistics operations.";
---

<BaseLayout title={title} description={description} path="/industries/logistics/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
