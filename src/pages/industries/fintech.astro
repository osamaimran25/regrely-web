---
import BaseLayout from "../../layouts/BaseLayout.astro";
import html from "../../partials/industries__fintech.html?raw";
import headHtml from "../../partials/industries__fintech.head.html?raw";
const title = "Fintech Privacy & Compliance Management Software | RegRely";
const description = "Centralize fintech privacy assessments, regulatory controls, risk registers, remediation evidence and data-rights requests in one compliance platform.";
---

<BaseLayout title={title} description={description} path="/industries/fintech/">
  <Fragment slot="head" set:html={headHtml} />
  <Fragment set:html={html} />
</BaseLayout>
